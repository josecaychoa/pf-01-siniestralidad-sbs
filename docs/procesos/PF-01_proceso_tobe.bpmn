    </serviceTask>
    <serviceTask id="Id_9b26051d-7108-4521-9904-0fb76c80453d" name="Cargar los datos en el modelo Oracle">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;scripts/cargar_oracle.py copia los CSV en las tablas stg_ y sql/oracle/03_carga_modelo.sql puebla las dimensiones dim_ y las tablas de hechos fct_.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
