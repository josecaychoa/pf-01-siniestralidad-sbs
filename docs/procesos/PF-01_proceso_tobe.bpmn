    <serviceTask id="Id_2fac5b07-d44d-4bbe-b9f2-421ca2a399a3" name="Descargar los boletines y registrar el manifiesto">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;scripts/descargar_sbs.py descarga por HTTPS el Bolet&amp;iacute;n Mensual de los 9 cortes y los cuadros S-401, S-402 y S-403, los guarda sin modificar en data/raw/ y registra en data/raw/manifest.csv la URL, la fecha de descarga y la huella SHA-256 de cada archivo.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
