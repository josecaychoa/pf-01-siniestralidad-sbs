      <incoming>Id_4eec2955-d729-48cb-b23b-ce57bb5a6c76</incoming>
      <outgoing>Id_d1cab068-ce5d-4d0b-bcdf-5c912b4df42e</outgoing>
    </serviceTask>
    <serviceTask id="Id_ff6306ca-189e-4919-943d-2fa82e430521" name="Extraer las hojas a formato largo con los catálogos">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;src/pf_01_siniestralidad_sbs/extraccion.py lleva las hojas P001 a P004 y P009 a P016 a formato largo y aplica los cat&amp;aacute;logos de empresas, riesgos, cortes y excepciones. Escribe tres CSV en data/interim/.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
