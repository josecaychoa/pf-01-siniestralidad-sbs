      <outgoing>Id_b192690c-912c-4093-ab08-e57d5c78dbe7</outgoing>
    </serviceTask>
    <serviceTask id="Id_d8df7dec-6fce-451a-8b1a-e34abf629120" name="Validar la estructura y los cuadres de los datos">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;scripts/validar_datos.py aplica 8 controles (estructura, cuadre con los totales publicados, jerarqu&amp;iacute;a de riesgos, balance, monedas, cuadros S-401 a S-403, cifras acumuladas y plan de cuentas) y escribe reports/validacion_datos.md.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
