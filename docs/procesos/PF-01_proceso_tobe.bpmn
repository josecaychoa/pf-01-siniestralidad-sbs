            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{&quot;isAsynchronous&quot;:false}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_05961e5d-2dc2-450b-b147-ce2ee4d4859f</incoming>
      <outgoing>Id_ff9a9345-0e81-4061-ab01-a12440ffbda6</outgoing>
    </serviceTask>
    <serviceTask id="Id_fe01852b-193c-4828-927e-26dc30bb1dc5" name="Validar los resultados frente a los índices publicados">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;scripts/validar_resultados.py compara los &amp;iacute;ndices calculados con los publicados, por corte y por riesgo (5 controles, tolerancia de 0.1 p. p.), y escribe reports/validacion_resultados.md.&lt;/span&gt;&lt;/p&gt;</documentation>
