    <userTask id="Id_7e86f907-cf77-4d92-a93b-007b7b648f02" name="Descargar el boletín de cada corte desde el portal">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;El analista descarga a mano el archivo de cada corte desde el portal del regulador y lo guarda en una carpeta de trabajo, sin registrar la fecha de descarga ni la versi&amp;oacute;n del archivo.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;notifyOnMobile&quot;:false,&quot;isSingleton&quot;:false,&quot;isConditional&quot;:false}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_1bdd181c-71a7-4ea4-b520-69ce9d59187c</incoming>
      <outgoing>Id_79f982d5-28b6-4ffe-8bee-dfef7f856b7e</outgoing>
    </userTask>
    <userTask id="Id_55808286-e359-40e8-b130-5dbd57250e33" name="Copiar las hojas de primas y siniestros a un libro consolidado">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;Copia las hojas de primas, siniestros e &amp;iacute;ndices de siniestralidad de cada corte a un libro consolidado. Las hojas vienen en formato ancho, con una columna por empresa.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;notifyOnMobile&quot;:false,&quot;isSingleton&quot;:false,&quot;isConditional&quot;:false}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_79f982d5-28b6-4ffe-8bee-dfef7f856b7e</incoming>
      <incoming>Id_f606dc2f-56d3-4c81-ac20-90e29ff3553c</incoming>
      <outgoing>Id_cea987c3-6975-4a6b-bc03-e15860f6c9ff</outgoing>
    </userTask>
    <userTask id="Id_2a672398-d53e-4096-a0c0-b948448c5b04" name="Homologar a mano las empresas y los riesgos entre cortes">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;Ajusta a mano los nombres de las empresas que cambiaron de raz&amp;oacute;n social, se fusionaron o se liquidaron, y alinea los riesgos que cambian de fila entre cortes.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;notifyOnMobile&quot;:false,&quot;isSingleton&quot;:false,&quot;isConditional&quot;:false}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_cea987c3-6975-4a6b-bc03-e15860f6c9ff</incoming>
      <outgoing>Id_67cd7649-1cc0-4b18-b05a-210b22e9b6ed</outgoing>
    </userTask>
    <userTask id="Id_0b1f100b-1456-4dc1-b0ab-b0592aaa93d9" name="Calcular el crecimiento y la siniestralidad con fórmulas">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;Calcula con f&amp;oacute;rmulas de hoja de c&amp;aacute;lculo el crecimiento de las primas netas y el &amp;iacute;ndice de siniestralidad de cada riesgo.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
