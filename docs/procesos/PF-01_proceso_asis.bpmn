    <userTask id="Id_d5ea8f12-555b-4f4b-8477-37bd7528fb83" name="Revisar las copias y las fórmulas">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;Busca la diferencia celda por celda, corrige la copia o la f&amp;oacute;rmula y vuelve a consolidar.&lt;/span&gt;&lt;/p&gt;</documentation>
