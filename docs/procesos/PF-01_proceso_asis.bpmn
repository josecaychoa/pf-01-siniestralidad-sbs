    <userTask id="Id_74c46bd7-0169-4e31-bf8f-310d7747a90d" name="Elaborar el reporte y los gráficos">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;a name="_dx_frag_StartFragment"&gt;&lt;/a&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:8pt;font-weight:normal;font-style:normal;"&gt;Arma el reporte con tablas y gr&amp;aacute;ficos copiados del libro consolidado.&lt;/span&gt;&lt;a name="_dx_frag_EndFragment"&gt;&lt;/a&gt;&lt;/p&gt;</documentation>
