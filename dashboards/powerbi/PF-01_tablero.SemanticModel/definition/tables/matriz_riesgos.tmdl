table matriz_riesgos
	lineageTag: b29d0263-e43b-43bb-92b6-08a2fca2aef2

	/// IA-PF01-01: siniestros netos / primas netas; nulo si las primas son 0 o negativas (vw_indicadores_riesgo)
	measure 'Siniestralidad directa' =
			VAR primas = SUM ( matriz_riesgos[primas_netas] )
			RETURN IF ( primas > 0, DIVIDE ( SUM ( matriz_riesgos[siniestros_netos] ), primas ) )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: ed5333e1-df63-4635-befc-564e304d9961

	/// IA-PF01-02: siniestros retenidos / primas retenidas (vw_indicadores_riesgo)
	measure 'Siniestralidad retenida' =
			VAR primas = SUM ( matriz_riesgos[primas_retenidas] )
			RETURN IF ( primas > 0, DIVIDE ( SUM ( matriz_riesgos[siniestros_retenidos] ), primas ) )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 39e7cf25-3f9c-4e1d-87f4-fe852e22dc45

	measure 'Siniestralidad de la medida' =
			IF (
			    NOT ISBLANK ( [Cuadrante de la medida] ),
			    IF ( [Medida seleccionada] = "Retenida", [Siniestralidad retenida], [Siniestralidad directa] )
			)
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 021f26cd-518e-4ff9-9343-4193c57ee290

	measure 'Cambio siniestralidad directa (p. p.)' = 100 * ( [Siniestralidad directa] - [Siniestralidad directa anterior] )
		formatString: 0.0
		displayFolder: Indicadores
		lineageTag: 9deb655e-7074-4c87-bdaa-3d1fb42065fc

	measure 'Cambio siniestralidad retenida (p. p.)' = 100 * ( [Siniestralidad retenida] - [Siniestralidad retenida anterior] )
		formatString: 0.0
		displayFolder: Indicadores
		lineageTag: 80a704d6-630e-4b99-b7bd-c5aa7db1b938

	measure 'Primas netas (millones)' = DIVIDE ( SUM ( matriz_riesgos[primas_netas] ), 1000 )
		displayFolder: Indicadores
		lineageTag: 32dc15fa-3485-483d-86d5-4729ea7054b1

		formatStringDefinition = IF ( ABS ( SELECTEDMEASURE () ) < 10000, "0.0", "# ##0.0" )

	/// IA-PF01-03: primas del corte actual / primas del corte anterior - 1 (vw_crecimiento_riesgo)
	measure 'Variación interanual de primas' =
			VAR actual = SUM ( crecimiento_riesgos[primas_actual] )
			VAR anterior = SUM ( crecimiento_riesgos[primas_anterior] )
			RETURN IF ( anterior > 0, DIVIDE ( actual, anterior ) - 1 )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 097501c6-caac-4387-9c4e-ac423939a865

	/// IA-PF01-04: columna tcac de vw_crecimiento_riesgo
	measure 'TCAC de primas' = IF ( HASONEVALUE ( crecimiento_riesgos[riesgo_comparable] ), DIVIDE ( MAX ( crecimiento_riesgos[tcac] ), 100 ) )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 5afd6a30-a327-4e1e-87ef-a32118522d41

	/// IA-PF01-05 (vw_matriz_riesgo)
	measure 'Participación en el sistema' = DIVIDE ( SUM ( matriz_riesgos[primas_netas] ), CALCULATE ( SUM ( matriz_riesgos[primas_netas] ), REMOVEFILTERS ( matriz_riesgos ) ) )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 92ceb961-932e-45c9-8c23-c9487826dfa3

	/// IA-PF01-07: corte de siniestralidad de vw_matriz_riesgo (D-PF01-16)
	measure 'Corte de siniestralidad' =
			DIVIDE (
			    CALCULATE (
			        IF ( [Medida seleccionada] = "Retenida", MAX ( matriz_riesgos[corte_siniestralidad_retenida] ), MAX ( matriz_riesgos[corte_siniestralidad_directa] ) ),
			        REMOVEFILTERS ( matriz_riesgos )
			    ),
			    100
			)
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 52432157-2ec4-453a-b457-173d901c6e31

	measure 'Corte de crecimiento' = DIVIDE ( CALCULATE ( MAX ( matriz_riesgos[corte_crecimiento] ), REMOVEFILTERS ( matriz_riesgos ) ), 100 )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 8bcf1972-6ae5-4d9b-be86-0b550acb78ec

	/// IA-PF01-07: riesgos por cuadrante de la medida elegida; en el total, los clasificados
	measure 'Riesgos en el cuadrante' =
			VAR m = [Medida seleccionada]
			VAR clasificados = FILTER ( matriz_riesgos, NOT ISBLANK ( IF ( m = "Retenida", matriz_riesgos[cuadrante_interanual_retenida], matriz_riesgos[cuadrante_interanual_directa] ) ) )
			VAR q = SELECTEDVALUE ( Cuadrante[Cuadrante] )
			RETURN
			    IF (
			        HASONEVALUE ( Cuadrante[Cuadrante] ),
			        COUNTROWS ( FILTER ( clasificados, IF ( m = "Retenida", matriz_riesgos[cuadrante_interanual_retenida], matriz_riesgos[cuadrante_interanual_directa] ) = q ) ),
			        COUNTROWS ( clasificados )
			    )
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 1eebf11b-0b10-4f15-9b2b-57e5ba15fe1b

	measure 'Primas en el cuadrante (millones)' =
			VAR m = [Medida seleccionada]
			VAR clasificados = FILTER ( matriz_riesgos, NOT ISBLANK ( IF ( m = "Retenida", matriz_riesgos[cuadrante_interanual_retenida], matriz_riesgos[cuadrante_interanual_directa] ) ) )
			VAR q = SELECTEDVALUE ( Cuadrante[Cuadrante] )
			VAR primas =
			    IF (
			        HASONEVALUE ( Cuadrante[Cuadrante] ),
			        SUMX ( FILTER ( clasificados, IF ( m = "Retenida", matriz_riesgos[cuadrante_interanual_retenida], matriz_riesgos[cuadrante_interanual_directa] ) = q ), matriz_riesgos[primas_netas] ),
			        SUMX ( clasificados, matriz_riesgos[primas_netas] )
			    )
			RETURN DIVIDE ( primas, 1000 )
		displayFolder: Indicadores
		lineageTag: 4dc8e71a-565e-4d11-bf30-21595ed013a8

		formatStringDefinition = IF ( ABS ( SELECTEDMEASURE () ) < 10000, "0.0", "# ##0.0" )

	measure 'Riesgos clasificados' = CALCULATE ( [Riesgos en el cuadrante], REMOVEFILTERS ( Cuadrante ) )
		formatString: 0
		displayFolder: Indicadores
		lineageTag: b3ef7bc7-8835-4884-8caf-f2d3facea7f6

	measure 'Riesgos que crecen sobre el corte' = CALCULATE ( [Riesgos en el cuadrante], Cuadrante[Cuadrante] = 1 )
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 328c5641-e873-4476-8e34-f7a87bf957d5

	measure Riesgos = COUNTROWS ( matriz_riesgos )
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 2aef5e41-0d4c-42b3-84a0-4941c39072fc

	/// Riesgos fuera de la matriz por situación (bajo el umbral; rentas y SPP, D-PF01-15); vacío en el total
	measure 'Riesgos fuera de la matriz' = IF ( HASONEVALUE ( matriz_riesgos[situacion] ) && SELECTEDVALUE ( matriz_riesgos[situacion] ) <> "En la matriz", [Riesgos] )
		formatString: 0
		displayFolder: Indicadores
		lineageTag: ffc716d8-a325-4da4-ba08-9c9217556ffa

	measure 'Primas fuera de la matriz (millones)' = IF ( HASONEVALUE ( matriz_riesgos[situacion] ) && SELECTEDVALUE ( matriz_riesgos[situacion] ) <> "En la matriz", [Primas netas (millones)] )
		displayFolder: Indicadores
		lineageTag: 297fba38-42bd-4895-a68d-3038e9912b7b

		formatStringDefinition = IF ( ABS ( SELECTEDMEASURE () ) < 10000, "0.0", "# ##0.0" )

	measure 'Frase del titular' =
			FORMAT ( [Riesgos que crecen sobre el corte], "0" ) & " de "
			    & FORMAT ( [Riesgos clasificados], "0" ) & " riesgos crecen con una siniestralidad "
			    & LOWER ( [Medida seleccionada] ) & " mayor que el corte de "
			    & FORMAT ( [Corte de siniestralidad], "0.0 %", "en-US" ) & "."
		displayFolder: Textos
		lineageTag: 632bfc21-b293-46ac-bbec-645808325b29

	measure 'Texto corte actual' = LOWER ( FORMAT ( [Corte actual], "mmmm", "es-PE" ) ) & " de " & FORMAT ( [Corte actual], "yyyy" )
		displayFolder: Textos
		lineageTag: d4955a54-677b-462a-80eb-9d1d1f3d1ea3

	measure 'Texto corte anterior' = LOWER ( FORMAT ( [Corte anterior], "mmmm", "es-PE" ) ) & " de " & FORMAT ( [Corte anterior], "yyyy" )
		displayFolder: Textos
		lineageTag: db189034-7998-4877-9d34-6ad75f10e273

	measure 'Nota cambio directa' =
			VAR d = [Cambio siniestralidad directa (p. p.)]
			RETURN IF ( d < 0, "−", "+" ) & FORMAT ( ABS ( d ), "0.0", "en-US" ) & " p. p. frente a " & [Texto corte anterior]
		displayFolder: Textos
		lineageTag: ff0b80f8-f7e1-47ef-876b-eab8b5d1ba1f

	measure 'Nota cambio retenida' =
			VAR d = [Cambio siniestralidad retenida (p. p.)]
			RETURN IF ( d < 0, "−", "+" ) & FORMAT ( ABS ( d ), "0.0", "en-US" ) & " p. p. frente a " & [Texto corte anterior]
		displayFolder: Textos
		lineageTag: e7b4d322-cee0-405e-a60f-a49fbf8df804

	measure 'Corte actual' = MAX ( matriz_riesgos[corte_actual] )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: _Auxiliares
		lineageTag: ff0909a2-1888-439d-848d-a9c1a20b9897

	measure 'Corte anterior' = MAX ( matriz_riesgos[corte_anterior] )
		formatString: yyyy-mm-dd
		isHidden
		displayFolder: _Auxiliares
		lineageTag: 46d25925-d8df-472d-9121-e19768833645

	measure 'Medida seleccionada' = SELECTEDVALUE ( Medida[Medida], "Directa" )
		isHidden
		displayFolder: _Auxiliares
		lineageTag: 67d3c611-35cd-4b6f-86f5-d459d2d60364

	measure 'Siniestralidad directa anterior' =
			VAR corte = CALCULATE ( [Corte anterior], REMOVEFILTERS ( matriz_riesgos ) )
			VAR primas = CALCULATE ( SUM ( indicadores_riesgo[primas_netas] ), indicadores_riesgo[fecha_corte] = corte )
			VAR siniestros = CALCULATE ( SUM ( indicadores_riesgo[siniestros_netos] ), indicadores_riesgo[fecha_corte] = corte )
			RETURN IF ( primas > 0, DIVIDE ( siniestros, primas ) )
		formatString: 0.0 %
		isHidden
		displayFolder: _Auxiliares
		lineageTag: 735fe9cd-2f28-455d-a306-3d565a98f58d

	measure 'Siniestralidad retenida anterior' =
			VAR corte = CALCULATE ( [Corte anterior], REMOVEFILTERS ( matriz_riesgos ) )
			VAR primas = CALCULATE ( SUM ( indicadores_riesgo[primas_retenidas] ), indicadores_riesgo[fecha_corte] = corte )
			VAR siniestros = CALCULATE ( SUM ( indicadores_riesgo[siniestros_retenidos] ), indicadores_riesgo[fecha_corte] = corte )
			RETURN IF ( primas > 0, DIVIDE ( siniestros, primas ) )
		formatString: 0.0 %
		isHidden
		displayFolder: _Auxiliares
		lineageTag: 4f6976ce-cdfa-41bd-b809-b164ca9b8b14

	measure 'Cuadrante de la medida' =
			VAR m = [Medida seleccionada]
			RETURN IF ( m = "Retenida", MAX ( matriz_riesgos[cuadrante_interanual_retenida] ), MAX ( matriz_riesgos[cuadrante_interanual_directa] ) )
		formatString: 0
		isHidden
		displayFolder: _Auxiliares
		lineageTag: 4eb52f28-3d7e-4cbe-9890-a1233e180db7

	measure 'Color del punto' = IF ( [Cuadrante de la medida] = 1, "#2A5CDA", "#C8CBCF" )
		displayFolder: Formato
		lineageTag: 982ef146-79f3-4257-b988-2b107e139012

	measure 'Nota corte actual' = "Acumulado a " & [Texto corte actual]
		displayFolder: Textos

	measure 'Nota corte anterior' = "Frente a " & [Texto corte anterior]
		displayFolder: Textos

	/// Límites de los ejes fijos de la dispersión (D-PF01-13): X de −40 % a 60 % e Y de 0 % a 100 %.
	/// Deben coincidir con categoryAxis y valueAxis del visual; 1 si el riesgo está en la matriz y no se dibuja.
	measure 'Fuera de escala' =
			VAR s = [Siniestralidad de la medida]
			VAR v = [Variación interanual de primas]
			RETURN IF ( NOT ISBLANK ( s ) && ( s > 1 || s < 0 || v > 0.6 || v < -0.4 ), 1 )
		formatString: 0
		isHidden
		displayFolder: _Auxiliares
		lineageTag: 2e2b2c3e-90af-44bf-bf4c-8f2d43ee7ceb

	measure 'Siniestralidad fuera de escala' = IF ( [Fuera de escala] = 1, [Siniestralidad de la medida] )
		formatString: 0.0 %
		displayFolder: Indicadores
		lineageTag: 0c592939-b5e5-442b-bd0c-108a7237bae5

	measure 'Variación fuera de escala' = IF ( [Fuera de escala] = 1, [Variación interanual de primas] )
		formatString: 0.0 %;−0.0 %
		displayFolder: Indicadores
		lineageTag: 71485a18-ad96-42a9-9e3a-bfcdd65d16ba

