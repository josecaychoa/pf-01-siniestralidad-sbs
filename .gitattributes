# Finales de línea LF en los CSV versionados (data/raw/manifest.csv).
# El script los escribe con LF; sin esta regla, Git en Windows (core.autocrlf=true)
# los extrae con CRLF y el árbol queda modificado después de cada ejecución.
*.csv text eol=lf

# Mismo caso para el informe que escribe scripts/validar_datos.py con LF.
reports/*.md text eol=lf

# Exportaciones de Bizagi (CRLF) y figura de tiempos de 3.4: se versionan tal como se
# verificaron, sin conversión de finales de línea; así no cambian los bytes del SVG que
# lleva el manifiesto de procedencia (Content Credentials).
docs/procesos/*.svg -text
docs/procesos/*.bpmn -text

# Figura de la serie de 4.2 (reports/figures/PF-01_serie.svg): mismos motivos que en
# docs/procesos/: bytes estables para la prueba de coincidencia con el script y para
# el manifiesto de procedencia (Content Credentials).
reports/figures/*.svg -text

# Exportación XML de Microsoft Project (gestion/cronograma/): normalizada a LF como el
# resto del historial. Project la exporta con CRLF en Windows y, si el commit se hace
# desde un entorno sin autocrlf (p. ej., la sesión de Claude en Linux), el blob quedaría
# con CRLF y el árbol de Windows aparecería modificado tras cada checkout.
gestion/cronograma/*.xml text eol=lf
