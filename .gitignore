.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep
# Matriz de 3.2: agregado propio con cita, publicable (regla de datos del portafolio)
!data/processed/matriz_riesgos.csv
# Serie y crecimiento de 3.2: agregados propios con cita, que lee el tablero Power BI (D-PF01-23)
!data/processed/indicadores_riesgo.csv
!data/processed/crecimiento_riesgos.csv
# Manifiesto de descargas: referencia de SHA-256 (sin datos de la fuente)
!data/raw/manifest.csv
.ipynb_checkpoints/
*.pbix

# Power BI (PBIP): configuración local y caché del modelo, propias de cada equipo
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Claude Code: configuración local de la sesión, no se comparte
.claude/settings.local.json

# Bóveda local que crearía el hook de commits de mypowers: no se versiona (sesión 9, D9 a)
vault/
